# Leave both unset for local dev (defaults: same-origin relative /api paths,
# no X-API-Key header — matches the Vite dev server proxy in vite.config.js).

# Base URL of the backend API, only needed when the built frontend is served
# from a different origin than the backend (no reverse proxy forwarding /api/*).
# VITE_API_BASE=https://api.your-production-domain.example

# Must match the backend's API_KEY (see ../../.env.example). This value is
# baked into the built JS bundle, so it is not secret from anyone who inspects
# the frontend — it only deters casual/automated abuse, not a targeted actor.
# VITE_API_KEY=
